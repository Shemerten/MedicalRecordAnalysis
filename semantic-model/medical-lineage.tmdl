createOrReplace

	relationship b84e8d40-1768-4ead-89a0-2b7dccb40f01
		fromColumn: domain_extraction_runs.document_id
		toColumn: domain_source_documents.document_id
		fromCardinality: many
		toCardinality: one
		crossFilteringBehavior: oneDirection

