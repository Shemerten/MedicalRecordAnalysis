		fromColumn: domain_diagnosis_mentions.run_key
		toColumn: domain_extraction_runs.run_key
		fromCardinality: many
		toCardinality: one
		crossFilteringBehavior: oneDirection

	relationship b84e8d40-1768-4ead-89a0-2b7dccb40f04
		fromColumn: domain_medication_mentions.run_key
		toColumn: domain_extraction_runs.run_key
		fromCardinality: many
		toCardinality: one
		crossFilteringBehavior: oneDirection

